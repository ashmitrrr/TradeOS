# ─── Copy this file to backend/.env and fill in your real keys ───────────────

# OpenAI — used for Whisper voice transcription
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic — used for Claude quote generation
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Resend — used to email the PDF quote to the client
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_...

# The "from" address for client emails.
# Must be a verified domain in Resend (or use onboarding@resend.dev for testing).
FROM_EMAIL=quotes@yourdomain.com.au

# Your business name — printed on the PDF and email
BUSINESS_NAME=My Trades Business

# ─── Server settings ──────────────────────────────────────────────────────────

# Port the Express server listens on (Railway sets this automatically)
PORT=3001

# Frontend URL — used for CORS (set to your Vercel URL in production)
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
