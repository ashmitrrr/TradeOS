# ─── Copy this file to .env and fill in your real keys ───────────────────────

# OpenAI — used for Whisper voice transcription
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic — used for Claude quote generation
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Resend — used to email the PDF quote to the client
RESEND_API_KEY=your-resend-api-key-here

# The "from" address for client emails (must be a verified Resend domain)
FROM_EMAIL=quotes@yourdomain.com.au

# Business name printed on PDFs and emails
BUSINESS_NAME=Your Business Name

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ─── Server settings ──────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ─── Internal API key — shared secret between frontend and backend ────────────
# Generate with: openssl rand -hex 32
# Must match VITE_API_KEY in the frontend .env
INTERNAL_API_KEY=your-secret-key-here
